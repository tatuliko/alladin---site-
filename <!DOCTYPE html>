      ];

      // თანმიმდევრობით დასალაგებელი ამბავი (სწორი რიგი: 1 -> 5)
      const CORRECT_SEQUENCE = [
        { id: 's1', order: 1, text: 'ალადინმა გამოქვაბულში დამტვერილ ლამპარს ხეხვა დაუწყო და ჯინი გაათავისუფლა.' },
        { id: 's2', order: 2, text: 'ჯინმა ალადინი გამოქვაბულიდან ამოიყვანა და მეგობრები აგრაბაჰისკენ გაფრინდნენ.' },
        { id: 's3', order: 3, text: 'ალადინის სურვილით ჯინმა ის ძვირფას სამოსში გამოაწყო და პრინც ალად გადააქცია.' },
        { id: 's4', order: 4, text: 'პრინცი ალი მფრინავი ხალიჩით სატახტო დარბაზში შეფრინდა და მბრძანებელი აღაფრთოვანა.' },
        { id: 's5', order: 5, text: 'იასმინი ალადინს ხალიჩაზე გვერდით მოუჯდა და ორივემ ვარსკვლავებიან ცაში იფრინა.' }
      ];

      // საწყისი ჯადოსნური ნივთები (მე-6 კითხვისთვის)
      const DEFAULT_MAGIC_ITEMS = [
        {
          name: 'ნატვრისთვალი',
          desc: 'ქართული ზღაპრების ჯადოსნური ქვა, რომელიც კეთილ გმირებს სურვილებს უსრულებს.',
          isCustom: false
        },
        {
          name: 'უჩინმაჩინის ქუდი',
          desc: 'ვინც ამ ქუდს დაიხურავს, უხილავი ხდება და შეუმჩნევლად გადაადგილდება.',
          isCustom: false
        },
        {
          name: 'ჯადოსნური სარკე',
          desc: 'სარკე, რომელიც სიმართლეს ამბობს და შორეულ ამბებს აჩვენებს.',
          isCustom: false
        },
        {
          name: 'მფრინავი ხალიჩა',
          desc: 'აღმოსავლური ზღაპრის ხალიჩა, რომელსაც მგზავრების ღრუბლებს ზემოთ გადაყვანა შეუძლია.',
          isCustom: false
        }
      ];

      /* =====================================================================
         2. მდგომარეობის მართვა (localStorage)
         ===================================================================== */
      const STORAGE_KEY = 'aladini_edu_progress_v1';

      let state = {
        readEpisodes: [],      // ['1', '2', '3']
        solvedQuestions: [],   // ['q1', 'q2', ...]
        sequenceSolved: false, // true / false
        customMagicItems: [],  // [{ name, desc, isCustom: true }]
        fontScale: 1           // 0.9, 1, 1.15, 1.3
      };

      function loadState() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            const parsed = JSON.parse(saved);
            state = { ...state, ...parsed };
          }
        } catch (err) {
          console.warn('პროგრესის წაკითხვა ვერ მოხერხდა:', err);
        }
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (err) {
          console.warn('პროგრესის შენახვა ვერ მოხერხდა:', err);
        }
      }

      function calculateScore() {
        const readPts = state.readEpisodes.length * 10;       // მაქს. 30
        const quizPts = state.solvedQuestions.length * 10;    // მაქს. 50
        const gamePts = state.sequenceSolved ? 20 : 0;        // მაქს. 20
        return Math.min(100, readPts + quizPts + gamePts);
      }

      function updateScoreUI() {
        const score = calculateScore();
        document.getElementById('total-score').textContent = score;
        document.getElementById('progress-percent').textContent = `${score}%`;
        document.getElementById('progress-bar-fill').style.width = `${score}%`;
        document.getElementById('progress-bar-container').setAttribute('aria-valuenow', score);

        // წაკითხვის ღილაკების განახლება
        document.querySelectorAll('.mark-read-btn').forEach(btn => {
          const epId = btn.getAttribute('data-read-btn');
          if (state.readEpisodes.includes(epId)) {
            btn.classList.remove('bg-turquoise', 'hover:bg-turquoiseDark');
            btn.classList.add('bg-emerald-700', 'cursor-default');
            btn.innerHTML = '<span>✓ წაკითხულია (+10 ქულა)</span>';
          } else {
            btn.classList.add('bg-turquoise', 'hover:bg-turquoiseDark');
            btn.classList.remove('bg-emerald-700', 'cursor-default');
            btn.innerHTML = '<span>წავიკითხე ეს ნაწილი (+10 ქულა)</span>';
          }
        });
      }

      loadState();

      /* =====================================================================
         3. ნავიგაცია და შრიფტის რეგულატორი
         ===================================================================== */
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mainNav = document.getElementById('main-nav');

      mobileMenuBtn.addEventListener('click', () => {
        const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
        mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
        mainNav.classList.toggle('hidden');
        mainNav.classList.toggle('flex');
      });

      // მობილურზე ბმულზე დაჭერისას მენიუს დახურვა
      document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            mainNav.classList.add('hidden');
            mainNav.classList.remove('flex');
            mobileMenuBtn.setAttribute('aria-expanded', 'false');
          }
        });
      });

      // შრიფტის ზომის შეცვლა ზღაპრის ტექსტისთვის
      function applyFontScale() {
        const baseRem = 1.125; // text-lg = 1.125rem
        document.querySelectorAll('.story-text').forEach(el => {
          el.style.fontSize = `${(baseRem * state.fontScale).toFixed(2)}rem`;
        });
      }

      document.getElementById('font-increase').addEventListener('click', () => {
        if (state.fontScale < 1.35) {
          state.fontScale = Number((state.fontScale + 0.12).toFixed(2));
          applyFontScale();
          saveState();
        }
      });

      document.getElementById('font-decrease').addEventListener('click', () => {
        if (state.fontScale > 0.85) {
          state.fontScale = Number((state.fontScale - 0.12).toFixed(2));
          applyFontScale();
          saveState();
        }
      });

      document.getElementById('font-reset').addEventListener('click', () => {
        state.fontScale = 1;
        applyFontScale();
        saveState();
      });

      applyFontScale();

      /* =====================================================================
         4. ზღაპრის ეპიზოდები და ინტერაქტიული ლექსიკონი
         ===================================================================== */
      const tabs = document.querySelectorAll('.episode-tab');
      const panels = document.querySelectorAll('.episode-panel');

      function activateTab(tabId) {
        tabs.forEach(t => {
          const isTarget = t.id === tabId;
          t.setAttribute('aria-selected', String(isTarget));
          if (isTarget) {
            t.classList.add('bg-night', 'text-goldBright', 'border-night', 'shadow-md');
            t.classList.remove('bg-parchment', 'text-night', 'border-gold/40');
          } else {
            t.classList.remove('bg-night', 'text-goldBright', 'border-night', 'shadow-md');
            t.classList.add('bg-parchment', 'text-night', 'border-gold/40');
          }
        });

        panels.forEach(panel => {
          const controlledBy = panel.getAttribute('aria-labelledby');
          if (controlledBy === tabId) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => activateTab(tab.id));
      });

      document.querySelectorAll('.next-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const nextId = btn.getAttribute('data-next-tab');
          activateTab(nextId);
          document.getElementById('story-section').scrollIntoView({ behavior: 'smooth' });
        });
      });

      // ეპიზოდის წაკითხულად მონიშვნა
      document.querySelectorAll('.mark-read-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const epId = btn.getAttribute('data-read-btn');
          if (!state.readEpisodes.includes(epId)) {
            state.readEpisodes.push(epId);
            saveState();
            updateScoreUI();
          }
        });
      });

      // ტექსტში გამოყოფილ სიტყვებზე დაწკაპუნება
      const popupBox = document.getElementById('word-popup-box');
      const popupTitle = document.getElementById('popup-word-title');
      const popupMeaning = document.getElementById('popup-word-meaning');
      const popupExample = document.getElementById('popup-word-example');

      document.querySelectorAll('.vocab-word').forEach(wordBtn => {
        wordBtn.addEventListener('click', () => {
          const targetWord = wordBtn.getAttribute('data-word');
          const entry = VOCABULARY.find(v => v.word === targetWord);
          if (entry) {
            popupTitle.textContent = entry.word;
            popupMeaning.textContent = entry.meaning;
            popupExample.textContent = `მაგალითი: ${entry.example}`;
            popupBox.classList.remove('hidden');
            popupBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      });

      document.getElementById('close-word-popup').addEventListener('click', () => {
        popupBox.classList.add('hidden');
      });

      // ლექსიკონის ბარათების რენდერი და ძიება
      const vocabGrid = document.getElementById('vocab-grid');
      const vocabEmptyMsg = document.getElementById('vocab-empty-msg');
      const vocabSearchInput = document.getElementById('vocab-search');

      function renderVocabulary(filterText = '') {
        const query = filterText.trim().toLowerCase();
        const filtered = VOCABULARY.filter(item =>
          item.word.toLowerCase().includes(query) ||
          item.meaning.toLowerCase().includes(query)
        );

        vocabGrid.innerHTML = '';
        if (filtered.length === 0) {
          vocabEmptyMsg.classList.remove('hidden');
          return;
        }
        vocabEmptyMsg.classList.add('hidden');

        filtered.forEach(item => {
          const card = document.createElement('article');
          card.className = 'bg-parchment border-2 border-gold/40 rounded-2xl p-5 shadow-sm flex flex-col justify-between';
          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="text-lg font-extrabold text-turquoiseDark">${item.word}</h3>
                <span class="text-gold text-sm" aria-hidden="true">✦</span>
              </div>
              <p class="text-sm text-ink leading-relaxed">${item.meaning}</p>
            </div>
            <p class="mt-3 pt-2.5 border-t border-gold/25 text-xs text-slate-700 italic">
              ${item.example}
            </p>
          `;
          vocabGrid.appendChild(card);
        });
      }

      vocabSearchInput.addEventListener('input', (e) => {
        renderVocabulary(e.target.value);
      });

      renderVocabulary();

      /* =====================================================================
         5. შეამოწმე ცოდნა (5 ინტერაქტიული კითხვა)
         ===================================================================== */
      const quizContainer = document.getElementById('quiz-container');

      function renderQuiz() {
        quizContainer.innerHTML = '';

        QUIZ_QUESTIONS.forEach((q) => {
          const isAlreadySolved = state.solvedQuestions.includes(q.id);

          const card = document.createElement('div');
          card.className = 'bg-parchment border-2 border-gold/50 rounded-3xl p-5 sm:p-6 shadow-md';
          card.id = `card-${q.id}`;

          const optionsHtml = q.options.map((opt, idx) => `
            <button type="button"
              data-q="${q.id}"
              data-idx="${idx}"
              class="quiz-option w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 border-slate-300 bg-white hover:border-turquoise hover:bg-teal-50/50 text-sm sm:text-base font-medium text-ink transition flex items-start gap-3">
              <span class="w-7 h-7 rounded-full bg-parchmentWarm border border-gold/50 text-night font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                ${['ა', 'ბ', 'გ'][idx]}
              </span>
              <span>${opt}</span>
            </button>
          `).join('');

          card.innerHTML = `
            <div class="flex flex-wrap items-start justify-between gap-2 mb-4">
              <h3 class="text-base sm:text-lg font-extrabold text-night">${q.question}</h3>
              <span id="badge-${q.id}" class="text-xs font-bold px-3 py-1 rounded-full ${isAlreadySolved ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}">
                ${isAlreadySolved ? '✓ შესრულებულია (+10)' : '10 ქულა'}
              </span>
            </div>

            <div class="space-y-2.5" role="group" aria-label="${q.question}">
              ${optionsHtml}
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
              <button type="button" data-hint-q="${q.id}" class="hint-btn text-xs sm:text-sm font-bold text-turquoiseDark hover:text-night underline underline-offset-4">
                💡 მინიშნება
              </button>
              <button type="button" data-retry-q="${q.id}" class="retry-btn hidden text-xs sm:text-sm font-bold text-gold hover:text-night underline underline-offset-4">
                ↻ ხელახლა ცდა
              </button>
            </div>

            <div id="hint-box-${q.id}" class="hidden mt-3 p-3 rounded-xl bg-amber-50 border border-amber-300 text-xs sm:text-sm text-amber-950">
              <strong>მინიშნება:</strong> ${q.hint}
            </div>

            <div id="feedback-${q.id}" class="hidden mt-3 p-3.5 rounded-xl border text-xs sm:text-sm font-medium" role="status" aria-live="polite"></div>
          `;

          quizContainer.appendChild(card);

          // თუ უკვე ამოხსნილია წინა სესიიდან, ვაჩვენოთ სწორი მდგომარეობა
          if (isAlreadySolved) {
            const buttons = card.querySelectorAll('.quiz-option');
            buttons.forEach((btn, idx) => {
              btn.disabled = true;
              if (idx === q.correctIndex) {
                btn.classList.remove('border-slate-300', 'bg-white');
                btn.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-950', 'font-bold');
              }
            });
            const fb = card.querySelector(`#feedback-${q.id}`);
            fb.classList.remove('hidden');
            fb.classList.add('bg-emerald-50', 'border-emerald-400', 'text-emerald-950');
            fb.textContent = q.explanation;
          }
        });

        // პასუხის არჩევის მსმენელები
        quizContainer.querySelectorAll('.quiz-option').forEach(btn => {
          btn.addEventListener('click', () => {
            const qId = btn.getAttribute('data-q');
            const chosenIdx = Number(btn.getAttribute('data-idx'));
            const qObj = QUIZ_QUESTIONS.find(item => item.id === qId);
            const card = document.getElementById(`card-${qId}`);
            const allOpts = card.querySelectorAll('.quiz-option');
            const feedbackEl = document.getElementById(`feedback-${qId}`);
            const retryBtn = card.querySelector(`.retry-btn`);

            allOpts.forEach(b => (b.disabled = true));
            feedbackEl.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-400', 'text-emerald-950', 'bg-rose-50', 'border-rose-400', 'text-rose-950');

            if (chosenIdx === qObj.correctIndex) {
              btn.classList.remove('border-slate-300', 'bg-white');
              btn.classList.add('border-emerald-600', 'bg-emerald-50', 'text-emerald-950', 'font-bold');

              feedbackEl.classList.add('bg-emerald-50', 'border-emerald-400', 'text-emerald-950');
              feedbackEl.innerHTML = `<strong>სწორია!</strong> ${qObj.explanation}`;
              retryBtn.classList.add('hidden');

              if (!state.solvedQuestions.includes(qId)) {
                state.solvedQuestions.push(qId);
                saveState();
                updateScoreUI();
              }
              const badge = document.getElementById(`badge-${qId}`);
              badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800';
              badge.textContent = '✓ შესრულებულია (+10)';
            } else {
              btn.classList.remove('border-slate-300', 'bg-white');
              btn.classList.add('border-rose-600', 'bg-rose-50', 'text-rose-950');

              feedbackEl.classList.add('bg-rose-50', 'border-rose-400', 'text-rose-950');
              feedbackEl.innerHTML = `<strong>არ არის სწორი.</strong> სცადე კიდევ ერთხელ ან ნახე მინიშნება!`;
              retryBtn.classList.remove('hidden');
            }
          });
        });

        // მინიშნების ღილაკები
        quizContainer.querySelectorAll('.hint-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const qId = btn.getAttribute('data-hint-q');
            document.getElementById(`hint-box-${qId}`).classList.toggle('hidden');
          });
        });

        // ხელახლა ცდის ღილაკები
        quizContainer.querySelectorAll('.retry-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const qId = btn.getAttribute('data-retry-q');
            const card = document.getElementById(`card-${qId}`);
            card.querySelectorAll('.quiz-option').forEach(opt => {
              opt.disabled = false;
              opt.className = 'quiz-option w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 border-slate-300 bg-white hover:border-turquoise hover:bg-teal-50/50 text-sm sm:text-base font-medium text-ink transition flex items-start gap-3';
            });
            document.getElementById(`feedback-${qId}`).classList.add('hidden');
            btn.classList.add('hidden');
          });
        });
      }

      renderQuiz();

      /* =====================================================================
         6. თამაში: „დაალაგე ამბავი თანმიმდევრობით“ (Drag & Drop + ღილაკები)
         ===================================================================== */
      const sequenceList = document.getElementById('sequence-list');
      const sequenceFeedback = document.getElementById('sequence-feedback');
      let currentSequence = [];
      let draggedIndex = null;

      function shuffleArray(arr) {
        const copy = [...arr];
        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        // დავრწმუნდეთ, რომ თავიდანვე სრულად დალაგებული არ ამოვიდეს
        const isAlreadySorted = copy.every((item, idx) => item.order === idx + 1);
        if (isAlreadySorted && copy.length > 1) {
          [copy[0], copy[1]] = [copy[1], copy[0]];
        }
        return copy;
      }

      function initSequenceGame() {
        currentSequence = state.sequenceSolved
          ? [...CORRECT_SEQUENCE]
          : shuffleArray(CORRECT_SEQUENCE);
        renderSequenceList();
      }

      function moveSequenceItem(fromIdx, toIdx) {
        if (toIdx < 0 || toIdx >= currentSequence.length) return;
        const [moved] = currentSequence.splice(fromIdx, 1);
        currentSequence.splice(toIdx, 0, moved);
        renderSequenceList();
      }

      function renderSequenceList() {
        sequenceList.innerHTML = '';

        currentSequence.forEach((item, index) => {
          const li = document.createElement('li');
          li.className = 'order-card bg-nightLight border-2 border-white/20 hover:border-goldBright rounded-2xl p-3.5 sm:p-4 flex items-center justify-between gap-3 cursor-grab active:cursor-grabbing transition';
          li.setAttribute('draggable', 'true');
          li.dataset.index = index;

          li.innerHTML = `
            <div class="flex items-center gap-3.5">
              <span class="w-8 h-8 rounded-xl bg-goldBright text-night font-extrabold text-sm flex items-center justify-center shrink-0" aria-hidden="true">
                ${index + 1}
              </span>
              <span class="text-sm sm:text-base text-white leading-snug">${item.text}</span>
            </div>

            <!-- ხელმისაწვდომი ღილაკები შეხებისა და კლავიატურისთვის -->
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button"
                class="move-up-btn p-2.5 rounded-xl bg-night hover:bg-turquoise text-white disabled:opacity-30 disabled:pointer-events-none transition"
                aria-label="ბარათის ზემოთ აწევა"
                ${index === 0 ? 'disabled' : ''}>
                ▲
              </button>
              <button type="button"
                class="move-down-btn p-2.5 rounded-xl bg-night hover:bg-turquoise text-white disabled:opacity-30 disabled:pointer-events-none transition"
                aria-label="ბარათის ქვემოთ ჩამოწევა"
                ${index === currentSequence.length - 1 ? 'disabled' : ''}>
                ▼
              </button>
            </div>
          `;

          // ღილაკებით გადაადგილება
          li.querySelector('.move-up-btn').addEventListener('click', () => moveSequenceItem(index, index - 1));
          li.querySelector('.move-down-btn').addEventListener('click', () => moveSequenceItem(index, index + 1));

          // Drag & Drop მოვლენები
          li.addEventListener('dragstart', () => {
            draggedIndex = index;
            li.classList.add('dragging');
          });

          li.addEventListener('dragend', () => {
            li.classList.remove('dragging');
            draggedIndex = null;
          });

          li.addEventListener('dragover', (e) => {
            e.preventDefault();
          });

          li.addEventListener('drop', (e) => {
            e.preventDefault();
            if (draggedIndex !== null && draggedIndex !== index) {
              moveSequenceItem(draggedIndex, index);
            }
          });

          sequenceList.appendChild(li);
        });
      }

      document.getElementById('check-sequence-btn').addEventListener('click', () => {
        let correctCount = 0;
        currentSequence.forEach((item, idx) => {
          if (item.order === idx + 1) correctCount++;
        });

        sequenceFeedback.classList.remove('hidden', 'bg-emerald-950/90', 'border-emerald-400', 'text-emerald-100', 'bg-amber-950/90', 'border-amber-400', 'text-amber-100');

        if (correctCount === CORRECT_SEQUENCE.length) {
          sequenceFeedback.classList.add('bg-emerald-950/90', 'border-emerald-400', 'text-emerald-100');
          sequenceFeedback.innerHTML = '<strong>შესანიშნავია!</strong> ზღაპრის ხუთივე ეპიზოდი სწორი თანმიმდევრობით დაალაგე!';
          if (!state.sequenceSolved) {
            state.sequenceSolved = true;
            saveState();
            updateScoreUI();
          }
        } else {
          sequenceFeedback.classList.add('bg-amber-950/90', 'border-amber-400', 'text-amber-100');
          sequenceFeedback.innerHTML = `<strong>სწორ ადგილას დგას ${correctCount} ბარათი 5-დან.</strong> გადახედე მოვლენებს: ჯერ გამოქვაბული და ლამპარია, შემდეგ პრინცად გადაქცევა, ბოლოს კი იასმინთან ერთად ფრენა.`;
        }
      });

      document.getElementById('shuffle-sequence-btn').addEventListener('click', () => {
        currentSequence = shuffleArray(CORRECT_SEQUENCE);
        renderSequenceList();
        sequenceFeedback.classList.add('hidden');
      });

      initSequenceGame();

      /* =====================================================================
         7. ჯადოსნური ნივთები და ფორმის ვალიდაცია (მე-6 კითხვა)
         ===================================================================== */
      const magicBoard = document.getElementById('magic-items-board');
      const magicForm = document.getElementById('magic-item-form');
      const formFeedback = document.getElementById('form-feedback');

      function renderMagicItems() {
        const allItems = [...DEFAULT_MAGIC_ITEMS, ...state.customMagicItems];
        magicBoard.innerHTML = '';

        allItems.forEach((item, idx) => {
          const card = document.createElement('article');
          card.className = `rounded-2xl p-4 border-2 shadow-sm flex flex-col justify-between ${
            item.isCustom
              ? 'bg-teal-50 border-turquoise'
              : 'bg-parchment border-gold/40'
          }`;

          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <h4 class="font-extrabold text-night text-base">${item.name}</h4>
                <span class="text-xs font-bold px-2 py-0.5 rounded-full ${
                  item.isCustom ? 'bg-turquoise text-white' : 'bg-goldBright/40 text-night'
                }">
                  ${item.isCustom ? 'შენი დამატებული' : 'ზღაპრული'}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">${item.desc}</p>
            </div>
          `;

          if (item.isCustom) {
            const customIdx = idx - DEFAULT_MAGIC_ITEMS.length;
            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'mt-3 self-start text-xs font-semibold text-rose-700 hover:underline';
            delBtn.textContent = 'წაშლა';
            delBtn.addEventListener('click', () => {
              state.customMagicItems.splice(customIdx, 1);
              saveState();
              renderMagicItems();
            });
            card.appendChild(delBtn);
          }

          magicBoard.appendChild(card);
        });
      }

      magicForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('magic-name');
        const descInput = document.getElementById('magic-desc');

        const nameVal = nameInput.value.trim();
        const descVal = descInput.value.trim();

        formFeedback.classList.remove('hidden', 'bg-rose-100', 'text-rose-900', 'border', 'border-rose-300', 'bg-emerald-100', 'text-emerald-900', 'border-emerald-300');

        if (nameVal.length < 3) {
          formFeedback.classList.add('bg-rose-100', 'text-rose-900', 'border', 'border-rose-300');
          formFeedback.textContent = 'გთხოვ ჩაწერო ჯადოსნური ნივთის სახელი (მინიმუმ 3 ასო).';
          nameInput.focus();
          return;
        }

        if (descVal.length < 6) {
          formFeedback.classList.add('bg-rose-100', 'text-rose-900', 'border', 'border-rose-300');
          formFeedback.textContent = 'გთხოვ მოკლედ აღწერო, რას აკეთებს ეს ნივთი (მინიმუმ 6 ასო).';
          descInput.focus();
          return;
        }

        state.customMagicItems.push({
          name: nameVal,
          desc: descVal,
          isCustom: true
        });
        saveState();
        renderMagicItems();

        formFeedback.classList.add('bg-emerald-100', 'text-emerald-900', 'border', 'border-emerald-300');
        formFeedback.textContent = `ყოჩაღ! „${nameVal}“ წარმატებით დაემატა ჯადოსნური ნივთების დაფაზე.`;

        nameInput.value = '';
        descInput.value = '';
      });

      renderMagicItems();

      /* =====================================================================
         8. პროგრესის განულება (უსაფრთხო დადასტურებით)
         ===================================================================== */
      const resetProgressBtn = document.getElementById('reset-progress-btn');
      const resetConfirmBar = document.getElementById('reset-confirm-bar');

      resetProgressBtn.addEventListener('click', () => {
        resetConfirmBar.classList.remove('hidden');
        resetConfirmBar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      document.getElementById('confirm-reset-no').addEventListener('click', () => {
        resetConfirmBar.classList.add('hidden');
      });

      document.getElementById('confirm-reset-yes').addEventListener('click', () => {
        state = {
          readEpisodes: [],
          solvedQuestions: [],
          sequenceSolved: false,
          customMagicItems: [],
          fontScale: 1
        };
        saveState();
        applyFontScale();
        updateScoreUI();
        renderQuiz();
        initSequenceGame();
        renderMagicItems();
        sequenceFeedback.classList.add('hidden');
        resetConfirmBar.classList.add('hidden');
      });

      // საწყისი UI-ს განახლება
      updateScoreUI();
    });
  </script>
</body>
</html>
